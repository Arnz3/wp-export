# Lokale uitvoermap (standaard ./export)
EXPORT_DIR=./export

# ID van de Google Drive-hoofdmap waarin per opticienId een map komt
# (laatste deel van https://drive.google.com/drive/folders/<ID>)
DRIVE_PARENT_FOLDER_ID=1HOgCL0b4hwgJxwch0EoAa8ghUaTHW0yu

# Uploadmethode: rclone (eigen Google-account, geen Cloud Console nodig) of api
UPLOADER=rclone
# Naam van de rclone-remote (aanmaken met: rclone config create gdrive drive scope=drive)
RCLONE_REMOTE=gdrive

# Enkel voor UPLOADER=api, kies één van beide:
# A) Service account (enkel met een Gedeelde Drive)
GOOGLE_SERVICE_ACCOUNT_FILE=
# B) Inloggen als jezelf (OAuth Desktop client)
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_TOKEN_FILE=token.json
